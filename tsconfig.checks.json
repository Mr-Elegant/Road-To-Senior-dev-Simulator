{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".next/cache/typecheck-all.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "scripts/**/*.ts",
    ".next/types/**/*.ts", ".next/dev/types/**/*.ts", ".vscode/ts-hover-prettify.d.ts"
  ],
  "exclude": ["node_modules", "practice"]
}
