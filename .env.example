# Google Gemini API Configuration (Server-Side Only)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# PostgreSQL Database URL (Prisma connection string)
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# Authentication (server-side only; generate a random secret of at least 32 characters)
BETTER_AUTH_SECRET="replace-with-a-unique-cryptographically-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

