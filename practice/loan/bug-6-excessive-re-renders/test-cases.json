          "applicantName": "Sophia",
          "loanAmount": 100,
          "status": "APPROVED"
        },
        {
          "id": "c",
          "applicantName": "Mina",
          "loanAmount": 500,
          "status": "PENDING"
        }
      ],
      "filters": {
        "status": "ALL",
        "search": " sophia "
      },
      "steps": [
        {
          "filters": {
            "status": "ALL",
            "search": "SOPHIA"
          }
        }
      ]
    },
    "expected": [
      {
        "ids": [
          "b"
        ],
        "sameAsPrevious": null
      },
      {
        "ids": [
