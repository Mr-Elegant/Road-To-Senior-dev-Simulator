[
  {
    "id": "unrelated",
    "name": "Opening a drawer preserves the selector result reference",
    "input": {
      "items": [
        {
          "id": "a",
          "applicantName": "Aarav",
          "loanAmount": 500,
          "status": "PENDING"
        },
        {
          "id": "b",
          "applicantName": "Sophia",
          "loanAmount": 100,
          "status": "APPROVED"
        },
        {
          "id": "c",
          "applicantName": "Mina",
          "loanAmount": 500,
          "status": "PENDING"
        }
      ],
      "filters": {
        "status": "ALL",
        "search": ""
      },
      "steps": [
        {
          "ui": {
            "drawerOpen": true
          }
        }
      ]
    },
    "expected": [
      {
        "ids": [
          "a",
          "b",
          "c"
        ],
        "sameAsPrevious": null
      },
      {
        "ids": [
          "a",
          "b",
          "c"
        ],
        "sameAsPrevious": true
      }
    ],
    "explanation": "useSelector observes result identity, so a fresh but identical array causes a render.",
    "sample": true
  },
  {
    "id": "filter-change",
    "name": "A changed status recomputes the result",
    "input": {
      "items": [
        {
          "id": "a",
          "applicantName": "Aarav",
          "loanAmount": 500,
          "status": "PENDING"
        },
        {
          "id": "b",
          "applicantName": "Sophia",
          "loanAmount": 100,
          "status": "APPROVED"
        },
        {
          "id": "c",
          "applicantName": "Mina",
          "loanAmount": 500,
          "status": "PENDING"
        }
      ],
      "filters": {
        "status": "ALL",
        "search": ""
      },
      "steps": [
        {
          "filters": {
            "status": "PENDING"
          }
        }
      ]
    },
    "expected": [
      {
        "ids": [
          "a",
          "b",
          "c"
        ],
        "sameAsPrevious": null
      },
      {
        "ids": [
          "a",
          "c"
        ],
        "sameAsPrevious": false
      }
    ],
    "explanation": "Memoization must not hide real filter changes.",
    "sample": true
  },
  {
