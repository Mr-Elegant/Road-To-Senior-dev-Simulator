[
  {
    "id": "duplicate",
    "name": "Suppress a duplicate described by a fresh object",
    "input": {
      "active": {
        "status": "loading",
        "query": {
          "search": "",
          "status": "ALL",
          "page": 1,
          "limit": 20
        }
      },
      "next": {
        "limit": 20,
        "page": 1,
        "status": "ALL",
        "search": ""
      }
    },
    "expected": false,
    "explanation": "Equivalent values identify duplicate work even when property order differs.",
    "sample": true
  },
  {
    "id": "new-search",
    "name": "Allow a newer search while the old query is loading",
    "input": {
      "active": {
        "status": "loading",
        "query": {
          "search": "",
          "status": "ALL",
          "page": 1,
          "limit": 20
        }
      },
      "next": {
        "search": "Sophia",
        "status": "ALL",
        "page": 1,
        "limit": 20
      }
    },
    "expected": true,
    "explanation": "A blanket loading guard would lose the latest user query.",
    "sample": true
  },
  {
    "id": "new-page",
    "name": "Pagination changes are distinct queries",
    "input": {
      "active": {
        "status": "loading",
        "query": {
          "search": "",
          "status": "ALL",
          "page": 1,
          "limit": 20
        }
      },
      "next": {
        "search": "",
        "status": "ALL",
        "page": 2,
        "limit": 20
      }
    },
    "expected": true,
    "explanation": "Page is part of the request identity.",
    "sample": false
  },
  {
    "id": "retry",
    "name": "Allow retrying the same failed request",
    "input": {
      "active": {
        "status": "failed",
        "query": {
          "search": "",
          "status": "ALL",
          "page": 1,
          "limit": 20
        }
      },
      "next": {
        "search": "",
        "status": "ALL",
        "page": 1,
        "limit": 20
      }
    },
    "expected": true,
    "explanation": "A failed request is no longer in flight.",
    "sample": false
  },
  {
    "id": "empty",
    "name": "Allow the first request",
    "input": {
      "active": null,
      "next": {
        "search": "",
        "status": "ALL",
        "page": 1,
        "limit": 20
      }
    },
    "expected": true,
    "explanation": "No active work means nothing to deduplicate.",
    "sample": false
  },
  {
    "id": "new-status",
    "name": "Status and page size also distinguish requests",
    "input": {
      "active": {
        "status": "loading",
        "query": {
          "search": "",
          "status": "ALL",
          "page": 1,
          "limit": 20
        }
      },
      "next": {
        "search": "",
        "status": "PENDING",
        "page": 1,
        "limit": 50
      }
    },
    "expected": true,
    "explanation": "Every documented query field participates in identity.",
    "sample": false
  }
]
