[
  {
    "id": "audit-1",
    "name": "Record a changed name without API keys",
    "inputDescription": "{\"context\":{\"tenantId\":\"a\",\"actorId\":\"u\"},\"before\":{\"id\":\"org\",\"tenantId\":\"a\",\"name\":\"Old\",\"status\":\"active\",\"plan\":\"pro\",\"apiKey\":\"synthetic-old\"},\"after\":{\"id\":\"org\",\"tenantId\":\"a\",\"name\":\"New\",\"status\":\"active\",\"plan\":\"pro\",\"apiKey\":\"synthetic-new\"}}",
    "expectedOutput": "{\"entry\":{\"tenantId\":\"a\",\"actorId\":\"u\",\"resourceId\":\"org\",\"action\":\"organization.updated\",\"changes\":[{\"field\":\"name\",\"before\":\"Old\",\"after\":\"New\"}]}}",
    "hidden": false
  },
  {
    "id": "audit-2",
    "name": "Secret-only changes produce no business audit entry",
    "inputDescription": "{\"context\":{\"tenantId\":\"a\",\"actorId\":\"u\"},\"before\":{\"id\":\"org\",\"tenantId\":\"a\",\"name\":\"Org\",\"status\":\"active\",\"plan\":\"pro\",\"credentials\":{\"token\":\"synthetic-old\"}},\"after\":{\"id\":\"org\",\"tenantId\":\"a\",\"name\":\"Org\",\"status\":\"active\",\"plan\":\"pro\",\"credentials\":{\"token\":\"synthetic-new\"}}}",
    "expectedOutput": "{\"entry\":null}",
    "hidden": false
  },
  {
    "id": "audit-3",
    "name": "Tenant mismatch cannot forge an audit entry",
    "inputDescription": "{\"context\":{\"tenantId\":\"a\",\"actorId\":\"u\"},\"before\":{\"id\":\"org\",\"tenantId\":\"b\",\"name\":\"Old\",\"status\":\"active\",\"plan\":\"pro\"},\"after\":{\"id\":\"org\",\"tenantId\":\"b\",\"name\":\"New\",\"status\":\"active\",\"plan\":\"pro\"}}",
    "expectedOutput": "{\"entry\":null}",
    "hidden": true
  },
  {
    "id": "audit-4",
    "name": "Missing trusted context is rejected",
    "inputDescription": "{\"context\":null,\"before\":{\"id\":\"org\",\"tenantId\":\"a\",\"name\":\"Old\",\"status\":\"active\",\"plan\":\"pro\"},\"after\":{\"id\":\"org\",\"tenantId\":\"a\",\"name\":\"New\",\"status\":\"active\",\"plan\":\"pro\"}}",
    "expectedOutput": "{\"entry\":null}",
    "hidden": true
  },
  {
    "id": "audit-5",
    "name": "Changes use fixed field ordering and trusted actor",
    "inputDescription": "{\"context\":{\"tenantId\":\"a\",\"actorId\":\"u\"},\"before\":{\"id\":\"org\",\"tenantId\":\"a\",\"name\":\"Old\",\"status\":\"active\",\"plan\":\"starter\"},\"after\":{\"id\":\"org\",\"tenantId\":\"a\",\"plan\":\"pro\",\"status\":\"paused\",\"name\":\"New\",\"actorId\":\"forged\",\"futureSecret\":\"synthetic-only\"}}",
    "expectedOutput": "{\"entry\":{\"tenantId\":\"a\",\"actorId\":\"u\",\"resourceId\":\"org\",\"action\":\"organization.updated\",\"changes\":[{\"field\":\"name\",\"before\":\"Old\",\"after\":\"New\"},{\"field\":\"status\",\"before\":\"active\",\"after\":\"paused\"},{\"field\":\"plan\",\"before\":\"starter\",\"after\":\"pro\"}]}}",
    "hidden": true
  },
  {
    "id": "audit-6",
    "name": "Different resource IDs are rejected",
    "inputDescription": "{\"context\":{\"tenantId\":\"a\",\"actorId\":\"u\"},\"before\":{\"id\":\"one\",\"tenantId\":\"a\",\"name\":\"Old\",\"status\":\"active\",\"plan\":\"pro\"},\"after\":{\"id\":\"two\",\"tenantId\":\"a\",\"name\":\"New\",\"status\":\"active\",\"plan\":\"pro\"}}",
    "expectedOutput": "{\"entry\":null}",
    "hidden": true
  },
  {
    "id": "audit-7",
    "name": "Objects in auditable fields cannot smuggle nested secrets",
    "inputDescription": "{\"context\":{\"tenantId\":\"a\",\"actorId\":\"u\"},\"before\":{\"id\":\"org\",\"tenantId\":\"a\",\"name\":\"Old\",\"status\":\"active\",\"plan\":\"pro\"},\"after\":{\"id\":\"org\",\"tenantId\":\"a\",\"name\":{\"password\":\"synthetic-only\"},\"status\":\"active\",\"plan\":\"pro\"}}",
    "expectedOutput": "{\"entry\":null}",
    "hidden": true
  },
