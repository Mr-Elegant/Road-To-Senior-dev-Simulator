    "inputDescription": "{\"context\":{\"tenantId\":\"a\",\"actorId\":\"u\"},\"before\":{\"id\":\"org\",\"tenantId\":\"a\",\"name\":\"Org\",\"status\":\"active\",\"plan\":\"pro\"},\"after\":{\"id\":\"org\",\"tenantId\":\"a\",\"name\":\"Org\",\"status\":\"active\",\"plan\":\"pro\"}}",
    "expectedOutput": "{\"entry\":null}",
