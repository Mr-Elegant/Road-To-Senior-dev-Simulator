[
  {
    "id": "auth-1",
    "name": "Read a public channel as active tenant user",
    "inputDescription": "{\"tenantId\":\"t\",\"channel\":{\"id\":\"c\",\"tenantId\":\"t\",\"private\":false,\"archived\":false},\"session\":{\"userId\":\"u\",\"tenantId\":\"t\",\"active\":true},\"members\":[],\"action\":\"read\"}",
    "expectedOutput": "{\"allowed\":true,\"reason\":\"allowed\"}",
    "hidden": false
  },
  {
    "id": "auth-2",
    "name": "Deny private channel to nonmember",
    "inputDescription": "{\"tenantId\":\"t\",\"channel\":{\"id\":\"c\",\"tenantId\":\"t\",\"private\":true,\"archived\":false},\"session\":{\"userId\":\"u\",\"tenantId\":\"t\",\"active\":true},\"members\":[],\"action\":\"read\"}",
    "expectedOutput": "{\"allowed\":false,\"reason\":\"forbidden\"}",
    "hidden": false
  },
  {
    "id": "auth-3",
    "name": "Deny cross-tenant session even with membership",
    "inputDescription": "{\"tenantId\":\"t\",\"channel\":{\"id\":\"c\",\"tenantId\":\"t\",\"private\":false,\"archived\":false},\"session\":{\"userId\":\"u\",\"tenantId\":\"other\",\"active\":true},\"members\":[{\"userId\":\"u\",\"role\":\"admin\",\"active\":true}],\"action\":\"read\"}",
    "expectedOutput": "{\"allowed\":false,\"reason\":\"forbidden\"}",
    "hidden": true
  },
  {
    "id": "auth-4",
    "name": "Deny inactive membership in private channel",
    "inputDescription": "{\"tenantId\":\"t\",\"channel\":{\"id\":\"c\",\"tenantId\":\"t\",\"private\":true,\"archived\":false},\"session\":{\"userId\":\"u\",\"tenantId\":\"t\",\"active\":true},\"members\":[{\"userId\":\"u\",\"role\":\"member\",\"active\":false}],\"action\":\"read\"}",
    "expectedOutput": "{\"allowed\":false,\"reason\":\"forbidden\"}",
    "hidden": true
  },
  {
    "id": "auth-5",
    "name": "Archived channels reject authorized sends",
    "inputDescription": "{\"tenantId\":\"t\",\"channel\":{\"id\":\"c\",\"tenantId\":\"t\",\"private\":false,\"archived\":true},\"session\":{\"userId\":\"u\",\"tenantId\":\"t\",\"active\":true},\"members\":[],\"action\":\"send\"}",
    "expectedOutput": "{\"allowed\":false,\"reason\":\"read_only\"}",
    "hidden": true
  },
  {
    "id": "auth-6",
    "name": "Public channel management still requires admin",
    "inputDescription": "{\"tenantId\":\"t\",\"channel\":{\"id\":\"c\",\"tenantId\":\"t\",\"private\":false,\"archived\":false},\"session\":{\"userId\":\"u\",\"tenantId\":\"t\",\"active\":true},\"members\":[],\"action\":\"manage\"}",
    "expectedOutput": "{\"allowed\":false,\"reason\":\"forbidden\"}",
    "hidden": true
  },
  {
    "id": "auth-7",
    "name": "Active admin can manage archived private channel",
    "inputDescription": "{\"tenantId\":\"t\",\"channel\":{\"id\":\"c\",\"tenantId\":\"t\",\"private\":true,\"archived\":true},\"session\":{\"userId\":\"u\",\"tenantId\":\"t\",\"active\":true},\"members\":[{\"userId\":\"u\",\"role\":\"admin\",\"active\":true}],\"action\":\"manage\"}",
    "expectedOutput": "{\"allowed\":true,\"reason\":\"allowed\"}",
    "hidden": true
  },
  {
    "id": "auth-8",
    "name": "Reject unknown action before missing session",
    "inputDescription": "{\"tenantId\":\"t\",\"channel\":{\"id\":\"c\",\"tenantId\":\"t\",\"private\":false,\"archived\":false},\"session\":null,\"members\":[],\"action\":\"delete_everything\"}",
    "expectedOutput": "{\"allowed\":false,\"reason\":\"invalid_action\"}",
    "hidden": true
  },
  {
    "id": "auth-9",
    "name": "Reject inactive session",
    "inputDescription": "{\"tenantId\":\"t\",\"channel\":{\"id\":\"c\",\"tenantId\":\"t\",\"private\":false,\"archived\":false},\"session\":{\"userId\":\"u\",\"tenantId\":\"t\",\"active\":false},\"members\":[],\"action\":\"read\"}",
    "expectedOutput": "{\"allowed\":false,\"reason\":\"unauthenticated\"}",
    "hidden": true
  },
  {
    "id": "auth-10",
    "name": "Reject cross-tenant channel",
    "inputDescription": "{\"tenantId\":\"t\",\"channel\":{\"id\":\"c\",\"tenantId\":\"other\",\"private\":false,\"archived\":false},\"session\":{\"userId\":\"u\",\"tenantId\":\"t\",\"active\":true},\"members\":[],\"action\":\"read\"}",
    "expectedOutput": "{\"allowed\":false,\"reason\":\"forbidden\"}",
    "hidden": true
  }
]
