  "executionDialect": "postgresql",
  "datasetId": "ecommerce",
  "realWorldScenario": "Merchandising wants to display product rank within each category from most expensive to least expensive.",
  "questionStatement": "Write a query to rank products within each `category` based on `price` descending. Return `category`, `name`, `price`, and `category_price_rank` using `DENSE_RANK() OVER (PARTITION BY category ORDER BY price DESC)`. Order final results by `category` ascending, then `category_price_rank` ascending.",
  "starterCode": "-- Rank products per category with DENSE_RANK\nSELECT\n  category,\n  name,\n  price,\n  DENSE_RANK() OVER (PARTITION BY category ORDER BY price DESC) AS category_price_rank\nFROM products\nORDER BY category ASC, category_price_rank ASC;",
  "expectedConcepts": [
    "Window function OVER() clause",
    "PARTITION BY window grouping",
    "DENSE_RANK vs RANK vs ROW_NUMBER"
  ],
  "hints": [
    "Use DENSE_RANK() OVER (PARTITION BY category ORDER BY price DESC).",
    "Order the final query by category ASC, category_price_rank ASC."
  ],
