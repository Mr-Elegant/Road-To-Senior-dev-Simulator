{
  "name": "full-stack-interview-lab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.checks.json",
    "typecheck:app": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/prisma-auth.mjs migrate deploy",
    "dev": "node scripts/build-react-runtime.mjs && next dev",
    "build": "node scripts/build-react-runtime.mjs && next build",
    "dev:webpack": "node scripts/build-react-runtime.mjs && next dev --webpack",
    "build:webpack": "node scripts/build-react-runtime.mjs && next build --webpack",
    "react:runtime": "node scripts/build-react-runtime.mjs",
    "start": "next start",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "practice:generate": "node scripts/practice/cli.cjs generate",
    "practice:list": "node scripts/practice/cli.cjs list",
    "practice:test": "node scripts/practice/cli.cjs test",
    "practice:test:all": "node scripts/practice/cli.cjs test all",
    "practice:watch": "node scripts/practice/cli.cjs watch",
    "practice:verify": "node --test tests/practice/*.test.cjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@google/genai": "^2.32.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.1.0",
    "@reduxjs/toolkit": "^2.13.0",
    "alasql": "^4.22.0",
    "better-auth": "1.7.15",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.21.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "sucrase": "3.35.1",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
